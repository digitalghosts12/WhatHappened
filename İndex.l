<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Clans</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
body{margin:0;font-family:Arial,sans-serif;background:#05070d;color:#fff;overflow:hidden}
#app{width:100vw;height:100vh;height:100dvh;display:flex;flex-direction:column;max-width:520px;margin:0 auto;background:#0b0f1a;position:relative;border-left:1px solid #222;border-right:1px solid #222}
header{text-align:center;padding:22px 10px 14px;position:relative;background:#0e1626;border-bottom:2px solid #1e2e4a}
header h1{margin:0;font-size:38px;letter-spacing:3px;font-weight:900}
header h1 span{color:#00e676}
header p{margin:4px 0 0;font-size:13px;opacity:.6;letter-spacing:4px}
#adminKlanlarBtn{position:absolute;top:12px;right:12px;background:#ff3b30;color:#fff;border:2px solid #ff6b60;border-radius:20px;padding:10px 14px;font-weight:900;font-size:13px;display:none;z-index:10;box-shadow:0 4px 0 #7a120c}
#centerArea{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:20px;gap:18px;overflow-y:auto}
.mainBtn{width:100%;max-width:360px;border:2px solid #000;border-radius:22px;padding:22px 20px;font-weight:900;font-size:20px;cursor:pointer;box-shadow:0 6px 0 rgba(0,0,0,.5)}
.mainBtn:active{transform:translateY(4px);box-shadow:0 2px 0 rgba(0,0,0,.5)}
.green{background:#00e676;color:#000;border-color:#00a854}
.yellow{background:#ffd700;color:#000;border-color:#b89600}
.tipText{text-align:center;font-size:13px;opacity:.6;line-height:1.5;padding:0 10px}
.card{width:100%;max-width:360px;background:#16213a;border:2px solid #2a3a5a;border-radius:22px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.4)}
.card h3{margin:0 0 12px;font-size:21px;text-align:center}
input{width:100%;padding:16px;border-radius:14px;border:2px solid #333;background:#0b0f1a;color:#fff;font-size:17px;margin-top:12px;outline:none}
input:focus{border-color:#00e676}
.smallBtn{width:100%;border:2px solid #000;border-radius:16px;padding:16px;font-weight:900;font-size:18px;margin-top:14px;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.5)}
.smallBtn:active{transform:translateY(2px)}
#adminBtn{position:absolute;left:10px;bottom:10px;background:#222;color:#ccc;border:2px solid #444;border-radius:20px;padding:10px 14px;font-size:13px;font-weight:900;z-index:999;touch-action:none;box-shadow:0 4px 0 #000}
#adminBtn.adminOn{background:#ff3b30;color:#fff;border-color:#ff6b60}
#adminBtn.dragging{background:#ffd700!important;color:#000!important;border-color:#b89600;transform:scale(1.15);box-shadow:0 10px 30px rgba(0,0,0,.6);z-index:1000}
#adminBtn.placed{position:fixed!important}
#langBtn{position:absolute;left:10px;bottom:104px;background:#16213a;color:#fff;border:2px solid #00e676;border-radius:20px;padding:10px 14px;font-size:13px;font-weight:900;z-index:1000;touch-action:none;box-shadow:0 4px 0 #004d2a}
#langBtn.dragging{background:#00e676!important;color:#000!important;transform:scale(1.15);box-shadow:0 10px 30px rgba(0,0,0,.6);z-index:1001}
#langBtn.placed{position:fixed!important}
#langPanel{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:2000;display:none;align-items:flex-end;justify-content:center}
#langPanel.show{display:flex}
#langBox{background:#16213a;width:100%;max-width:520px;max-height:80vh;overflow-y:auto;border-radius:25px 25px 0 0;padding:20px;padding-bottom:30px;border-top:3px solid #00e676}
#langBox h3{margin:0 0 6px;text-align:center;font-size:22px}
#langBox p{text-align:center;font-size:13px;opacity:.6;margin:0 0 14px}
.langItem{display:flex;align-items:center;gap:12px;background:#0b0f1a;border:2px solid #333;padding:15px 16px;border-radius:16px;margin-top:10px;cursor:pointer;font-size:16px;font-weight:700}
.langItem:active{transform:scale(.98);border-color:#00e676}
.langItem.active{border-color:#00e676;background:#0e2a1a}
.langItem .flag{font-size:26px}
.langItem .check{margin-left:auto;color:#00e676;font-size:20px}
#chatScreen{display:none;flex-direction:column;height:100%;position:relative}
#chatHeader{display:flex;align-items:center;gap:10px;padding:12px;background:#16213a;border-bottom:2px solid #2a3a5a}
#chatHeader button{background:#fff;border:2px solid #ccc;border-radius:20px;padding:8px 14px;font-weight:900;cursor:pointer}
#selectBar{display:none;align-items:center;gap:10px;padding:10px 12px;background:#ff3b30;color:#fff;transform:translateY(-4px);margin-top:-4px;border-bottom:2px solid #7a120c}
#selectBar b{flex:1}
#selectBar button{background:#fff;color:#ff3b30;border:none;border-radius:20px;padding:8px 14px;font-weight:900}
#selectBar .cancel{background:transparent;color:#fff;border:2px solid #fff}
#messages{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:84%;padding:11px 13px;border-radius:18px;font-size:15px;word-break:break-word;transition:all .2s;touch-action:none;box-shadow:0 3px 8px rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1)}
.me{align-self:flex-end;background:#00a884;color:#fff}
.other{align-self:flex-start;background:#1e2e4a;color:#fff}
.msg.selected{background:#1db954!important;box-shadow:0 0 0 2px #00e676;transform:scale(1.03)}
.msg small{display:block;font-size:11px;opacity:.7;margin-top:5px}
.pollBox{background:rgba(0,0,0,.25);border:2px solid #ffd700;border-radius:16px;padding:10px;margin-top:6px}
.pollBox b{font-size:15px}
.pollOpt{position:relative;background:#0b0f1a;border:2px solid #333;border-radius:12px;padding:10px 12px;margin-top:8px;cursor:pointer;overflow:hidden;font-weight:700;font-size:14px}
.pollOpt:active{transform:scale(.98)}
.pollOpt .fill{position:absolute;left:0;top:0;bottom:0;background:#00e676;opacity:.35;transition:width .4s}
.pollOpt .txt{position:relative;display:flex;justify-content:space-between;gap:8px}
.pollOpt.voted{border-color:#00e676}
.pollOpt.votedMine{border-color:#ffd700;background:#2a2a0a}
.pollTotal{font-size:12px;opacity:.7;margin-top:8px;text-align:center}
.memberList{display:flex;flex-wrap:wrap;gap:6px}
.member{background:#0b0f1a;border:1px solid #333;padding:6px 11px;border-radius:20px;font-size:12px}
#inputBar{display:flex;gap:8px;padding:10px;background:#16213a;align-items:center;border-top:2px solid #2a3a5a;position:relative}
#inputBar input{margin:0;flex:1;border-radius:25px}
.iconBtn{width:50px;height:50px;border-radius:50%;border:2px solid #000;font-size:22px;flex-shrink:0;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.4)}
.iconBtn:active{transform:translateY(2px)}
.sendBtn{background:#00e676;color:#000}
.pollBtn{background:#ffd700;color:#000;border:2px solid #b89600!important;box-shadow:0 4px 0 #b89600!important}
.pollBtn.open{background:#00e676!important;border-color:#00a854!important;box-shadow:0 4px 0 #004d2a!important}
.hidden{display:none!important}
.backLink{text-align:center;margin-top:12px;font-size:14px;opacity:.7;cursor:pointer;background:#0b0f1a;border:1px solid #333;padding:10px;border-radius:14px}
#adminPanel{position:absolute;inset:0;background:#0b0f1a;z-index:100;display:none;flex-direction:column;overflow-y:auto}
#adminPanel header{padding:16px;background:#ff3b30;color:#fff}
.adminCard{background:#16213a;border:2px solid #ff3b30;border-radius:16px;padding:15px;margin:10px;cursor:pointer;box-shadow:0 4px 10px rgba(0,0,0,.3)}
.adminCard:active{transform:scale(.98)}
#dragHint{display:none;position:fixed;left:50%;bottom:80px;transform:translateX(-50%);background:#ffd700;color:#000;padding:11px 17px;border-radius:25px;font-weight:900;font-size:13px;z-index:1001;white-space:nowrap;border:2px solid #b89600;box-shadow:0 6px 20px rgba(0,0,0,.5)}
#pollPanel{position:absolute;left:10px;bottom:calc(100% + 38px);background:#16213a;border:2px solid #ffd700;border-radius:20px;padding:16px;z-index:500;display:none;flex-direction:column;gap:10px;box-shadow:0 10px 30px rgba(0,0,0,.6);width:calc(100vw - 20px);max-width:480px;max-height:60vh;overflow-y:auto}
#pollPanel.show{display:flex}
#pollPanel h3{margin:0;text-align:center}
#pollPanel input{margin:0;padding:12px;font-size:15px}
#pollPanel .pollBtns{display:flex;gap:8px}
#pollPanel .pollBtns button{flex:1;border:2px solid #000;border-radius:14px;padding:12px;font-weight:900;font-size:14px;cursor:pointer}
.pollOptInput{display:flex;gap:8px;align-items:center}
.pollOptInput button{background:#ff3b30;color:#fff;border:none;border-radius:50%;width:32px;height:32px;font-weight:900;flex-shrink:0}
</style>
</head>
<body>
<div id="app">
<div id="home" style="display:flex;flex-direction:column;height:100%">
<header><h1><span>CLANS</span></h1><p>CLANS</p><button id="adminKlanlarBtn" onclick="openAdminPanel()">👀 <span data-t="viewClans">View Clans</span></button></header>
<div id="centerArea">
<div id="menuBtns" style="width:100%;max-width:360px;display:flex;flex-direction:column;gap:18px">
<button class="mainBtn green" onclick="showCreate()">➕ <span data-t="createClan">CREATE CLAN</span></button>
<button class="mainBtn yellow" onclick="showAra()">🔍 <span data-t="findClan">FIND CLAN</span></button>
<div class="tipText">💡 <span data-t="tip">Tip: Hold Admin or Language button 1 sec to move it</span></div>
</div>
<div id="createBox" class="card hidden"><h3>➕ <span data-t="createClanTitle">Create Clan</span></h3><input id="createName" placeholder="Name"><input id="createPass" placeholder="Password" type="password"><button class="smallBtn green" onclick="createClan()"><span data-t="createBtn">CREATE ✅</span></button><div class="backLink" onclick="backToMenu()">◀ <span data-t="back">Back</span></div></div>
<div id="araBox" class="card hidden"><h3>🔍 <span data-t="findClanTitle">Find Clan</span></h3><input id="araName" placeholder="Name"><input id="araPass" placeholder="Password" type="password"><button class="smallBtn yellow" onclick="araGir()"><span data-t="searchBtn">SEARCH 🔍</span></button><div class="backLink" onclick="backToMenu()">◀ <span data-t="back">Back</span></div></div>
</div></div>
<div id="chatScreen">
<div id="chatHeader"><button onclick="backHome()">◀</button><div style="flex:1"><b id="chatTitle">Clan</b><br><span id="chatInfo" style="font-size:12px;opacity:.7"></span></div><button onclick="leaveClan()" style="background:#ff3b30;color:#fff;border-color:#7a120c"><span data-t="leave">Leave</span></button></div>
<div id="selectBar"><b id="selectText">1 message selected</b><button onclick="deleteSelected()">🗑️ <span data-t="delete">Delete</span></button><button class="cancel" onclick="clearSelection()">✕</button></div>
<div style="padding:8px 12px"><div class="memberList" id="memberList"></div></div>
<div id="messages"></div>
<div id="inputBar">
<button class="iconBtn pollBtn" id="pollBtn" onclick="togglePoll()">📊</button>
<input id="msgInput" placeholder="Write message..." onkeydown="if(event.key==='Enter') sendMsg()">
<button class="iconBtn sendBtn" onclick="sendMsg()">➤</button>
<div id="pollPanel">
<h3>📊 Anket Oluştur</h3>
<input id="pollQ" placeholder="Sorun ne? Örn: Yarın oynuyor muyuz?">
<div id="pollOpts"><div class="pollOptInput"><input class="pollOptVal" placeholder="Şık 1 - Örn: Evet"><button onclick="this.parentElement.remove()">✕</button></div><div class="pollOptInput"><input class="pollOptVal" placeholder="Şık 2 - Örn: Hayır"><button onclick="this.parentElement.remove()">✕</button></div></div>
<button style="background:#0b0f1a;color:#fff;border:2px dashed #666;border-radius:14px;padding:10px;font-weight:900" onclick="addPollOpt()">➕ Şık Ekle</button>
<div class="pollBtns"><button style="background:#fff;color:#ff3b30" onclick="togglePoll()">✕ İptal</button><button style="background:#ffd700;color:#000" onclick="createPoll()">📊 Anketi Oluştur</button></div>
</div>
</div>
</div>
<button id="langBtn">🌐 EN</button>
<button id="adminBtn">⚙️ <span data-t="admin">Admin</span></button>
<div id="dragHint">☝️ Now drag it, it will stay where you drop it</div>
<div id="langPanel" onclick="if(event.target===this) closeLang()"><div id="langBox"><div class="langItem" onclick="closeLang()" style="justify-content:center;background:#ff3b30;border-color:#ff3b30;color:#fff;margin-top:0;margin-bottom:14px">✕ <span data-t="close">Close</span></div><h3>🌐 <span data-t="chooseLang">Choose Language</span></h3><p><span data-t="chooseLangSub">Select your language, everything will change</span></p><div id="langList"></div></div></div>
<div id="adminPanel"><header style="display:flex;justify-content:space-between;align-items:center"><div><b style="font-size:20px">👀 <span data-t="allClans">All Clans</span></b><br><span style="font-size:13px" data-t="tapToEnter">Tap one, enter secretly 👻</span></div><button onclick="closeAdminPanel()" style="background:#fff;border:none;padding:10px 14px;border-radius:20px;font-weight:900">✕ <span data-t="close">Close</span></button></header><div style="padding:10px"><div style="background:#16213a;border:2px solid #2a3a5a;padding:12px;border-radius:14px;text-align:center"><span data-t="totalClans">Total Clans</span>: <b id="totalClan">0</b></div></div><div id="adminList"></div></div>
</div>
