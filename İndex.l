};
function applyLang(){document.querySelectorAll('[data-t]').forEach(el=>{let k=el.getAttribute('data-t');if(T[lang]&&T[lang][k])el.textContent=T[lang][k]});let cur=LANGS.find(l=>l.code===lang);document.getElementById('langBtn').textContent='🌐 '+cur.code.toUpperCase();document.getElementById('msgInput').placeholder=T[lang].writeMsg;document.getElementById('createName').placeholder=T[lang].name;document.getElementById('createPass').placeholder=T[lang].pass;document.getElementById('araName').placeholder=T[lang].name;document.getElementById('araPass').placeholder=T[lang].pass;document.documentElement.lang=lang;localStorage.setItem('mortoist_lang',lang);renderLangList();if(currentClanId){let c=clans.find(x=>x.id===currentClanId);if(c){document.getElementById('chatInfo').textContent=c.members.length+' '+T[lang].members+(isAdmin?' • '+T[lang].secret:'');c.messages.forEach(m=>{if(m._sys==='created')m.text=T[lang].clanCreated;if(m._sys==='welcome')m.text=T[lang].welcome;if(m._sys==='welcome2')m.text=T[lang].welcome2;if(m._sys==='welcome3')m.text=T[lang].welcome3;});renderMessages();}}if(isAdmin){document.getElementById('adminBtn').textContent='👑 '+T[lang].admin+' (On)';}}
function openLang(){document.getElementById('langPanel').classList.add('show');renderLangList();}
function closeLang(){document.getElementById('langPanel').classList.remove('show');}
function renderLangList(){document.getElementById('langList').innerHTML=LANGS.map(l=>`<div class="langItem ${l.code===lang?'active':''}" onclick="setLang('${l.code}')"><span class="flag">${l.flag}</span> ${l.name} <span style="opacity:.5">(${l.code.toUpperCase()})</span> ${l.code===lang?'<span class="check">✓</span>':''}</div>`).join('');}
function setLang(code){lang=code;applyLang();closeLang();}
applyLang();
if(clans.length===0){clans=[{id:1,name:"Kaan",pass:"1234",members:["Kaan","Efe"],messages:[{user:"Kaan",text:"Hello squad!",time:"12:00",_sys:"welcome"},{user:"Efe",text:"Hello!",time:"12:01",_sys:"welcome2"}]},{id:2,name:"Kaan Kings",pass:"kaan",members:["Kaan","Deniz"],messages:[{user:"Kaan",text:"Welcome!",time:"12:05",_sys:"welcome3"}]}];localStorage.setItem('mortoist_clans',JSON.stringify(clans));}
function save(){localStorage.setItem('mortoist_clans',JSON.stringify(clans));}
function showAdminBtn(){document.getElementById('adminBtn').style.display='block';document.getElementById('langBtn').style.display='block';}
function hideAdminBtn(){document.getElementById('adminBtn').style.display='none';document.getElementById('langBtn').style.display='none';}
function backToMenu(){document.getElementById('createBox').classList.add('hidden');document.getElementById('araBox').classList.add('hidden');document.getElementById('menuBtns').classList.remove('hidden');showAdminBtn();}
function showCreate(){document.getElementById('menuBtns').classList.add('hidden');document.getElementById('araBox').classList.add('hidden');document.getElementById('createBox').classList.remove('hidden');hideAdminBtn();}
function showAra(){document.getElementById('menuBtns').classList.add('hidden');document.getElementById('createBox').classList.add('hidden');document.getElementById('araBox').classList.remove('hidden');hideAdminBtn();}
function createClan(){let n=document.getElementById('createName').value.trim(),p=document.getElementById('createPass').value.trim();if(!n||!p){alert(T[lang].writeNamePass);return;}myName=n;let c={id:Date.now(),name:n,pass:p,members:[n],messages:[{user:'System',text:T[lang].clanCreated,time:'Now',_sys:'created'}]};clans.push(c);save();openChat(c.id);}
function araGir(){let n=document.getElementById('araName').value.trim(),p=document.getElementById('araPass').value.trim();if(!n||!p){alert(T[lang].writeNamePass);return;}let c=clans.find(x=>x.name.toLowerCase()===n.toLowerCase()&&x.pass===p);if(!c){alert(T[lang].noClan);return;}myName=n;if(!isAdmin&&!c.members.includes(n))c.members.push(n);save();openChat(c.id,isAdmin);}
function adminLogin(){if(isAdmin){openAdminPanel();return;}let p=prompt(T[lang].enterPass);if(p===null)return;if(p===ADMIN_PASS){isAdmin=true;document.getElementById('adminBtn').textContent='👑 '+T[lang].admin+' (On)';document.getElementById('adminBtn').classList.add('adminOn');document.getElementById('adminKlanlarBtn').style.display='block';alert(T[lang].correctPass);backToMenu();}else alert(T[lang].wrongPass);}
function openAdminPanel(){if(!isAdmin){adminLogin();return;}document.getElementById('adminPanel').style.display='flex';document.getElementById('totalClan').textContent=clans.length;document.getElementById('adminList').innerHTML=clans.map(c=>`<div class="adminCard" onclick="adminViewClan(${c.id})"><b>👑 ${c.name}</b><p>🔑 ${T[lang].passwordLabel}: ${c.pass} • 👥 ${c.members.join(', ')} • 💬 ${c.messages.length}</p><p style="color:#00e676">${T[lang].clickToEnter}</p></div>`).join('');}
function closeAdminPanel(){document.getElementById('adminPanel').style.display='none';if(isAdmin)document.getElementById('adminKlanlarBtn').style.display='block';}
function adminViewClan(id){closeAdminPanel();let c=clans.find(x=>x.id===id);currentClanId=id;myName='👻 Admin (Secret)';document.getElementById('home').style.display='none';document.getElementById('chatScreen').style.display='flex';hideAdminBtn();document.getElementById('chatTitle').textContent=c.name+' [SECRET 👻]';document.getElementById('chatInfo').textContent=c.members.length+' '+T[lang].members+' • '+T[lang].secret;document.getElementById('memberList').innerHTML=c.members.map(m=>`<span class="member">👤 ${m}</span>`).join('');renderMessages();}
function openChat(id,g=false){currentClanId=id;let c=clans.find(x=>x.id===id);document.getElementById('home').style.display='none';document.getElementById('chatScreen').style.display='flex';hideAdminBtn();document.getElementById('chatTitle').textContent=c.name+(g?' [SECRET 👻]':'');document.getElementById('chatInfo').textContent=c.members.length+' '+T[lang].members;document.getElementById('memberList').innerHTML=c.members.map(m=>`<span class="member">👤 ${m}</span>`).join('');renderMessages();}
function backHome(){document.getElementById('chatScreen').style.display='none';document.getElementById('home').style.display='flex';backToMenu();clearSelection();if(isAdmin)document.getElementById('adminKlanlarBtn').style.display='block';showAdminBtn();}
function escapeHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function renderMessages(){let c=clans.find(x=>x.id===currentClanId);if(!c)return;let b=document.getElementById('messages');b.innerHTML=c.messages.map((m,i)=>{let content=escapeHtml(m.text||'');if(m.poll){let total=Object.keys(m.poll.votes||{}).length;let opts=m.poll.options.map((o,oi)=>{let cnt=Object.values(m.poll.votes||{}).filter(v=>v===oi).length;let pct=total?Math.round(cnt/total*100):0;let mine=m.poll.votes&&m.poll.votes[myName]===oi;let voted=m.poll.votes&&m.poll.votes[myName]!==undefined;return `<div class="pollOpt ${voted?'voted':''} ${mine?'votedMine':''}" onclick="votePoll(${i},${oi})"><div class="fill" style="width:${pct}%"></div><div class="txt"><span>${escapeHtml(o)} ${mine?'✅':''}</span><span>${cnt} oy • %${pct}</span></div></div>`}).join('');content=`<div class="pollBox"><b>📊 ${escapeHtml(m.poll.q)}</b>${opts}<div class="pollTotal">Toplam ${total} oy ${m.poll.votes&&m.poll.votes[myName]!==undefined?'- Oy verdin ✅':'- Oy vermek için şıkka tıkla'}</div></div>`;}return `<div class="msg ${m.user===myName?'me':'other'} ${selectedIndex===i?'selected':''}" data-index="${i}">${m.user!==myName?`<b style="font-size:12px">${escapeHtml(m.user)}</b><br>`:''}${content}<small>${m.time}</small></div>`}).join('');b.scrollTop=b.scrollHeight;attachLongPress();}
function attachLongPress(){document.querySelectorAll('.msg').forEach(el=>{let idx=parseInt(el.dataset.index),timer=null;el.addEventListener('touchstart',()=>{timer=setTimeout(()=>{selectMessage(idx);if(navigator.vibrate)navigator.vibrate(50);},1000);},{passive:true});el.addEventListener('touchmove',()=>clearTimeout(timer));el.addEventListener('touchend',()=>clearTimeout(timer));el.addEventListener('mousedown',()=>{timer=setTimeout(()=>selectMessage(idx),1000);});el.addEventListener('mouseup',()=>clearTimeout(timer));el.addEventListener('click',e=>{if(e.target.closest('.pollOpt'))return;if(selectedIndex!==-1)selectMessage(idx);});});}
function selectMessage(i){if(selectedIndex===i){clearSelection();return;}selectedIndex=i;document.querySelectorAll('.msg').forEach(el=>el.classList.remove('selected'));let el=document.querySelector(`.msg[data-index="${i}"]`);if(el)el.classList.add('selected');document.getElementById('selectBar').style.display='flex';document.getElementById('selectText').textContent=T[lang].selectMsg;}
function clearSelection(){selectedIndex=-1;document.getElementById('selectBar').style.display='none';document.querySelectorAll('.msg').forEach(el=>el.classList.remove('selected'));}
function deleteSelected(){if(selectedIndex===-1)return;if(!confirm(T[lang].deleteMsgQ))return;let c=clans.find(x=>x.id===currentClanId);c.messages.splice(selectedIndex,1);save();clearSelection();renderMessages();}
function sendMsg(){let inp=document.getElementById('msgInput'),txt=inp.value.trim();if(!txt)return;let c=clans.find(x=>x.id===currentClanId);c.messages.push({user:isAdmin?'👻 Admin':myName,text:txt,time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})});save();inp.value='';clearSelection();renderMessages();}
function leaveClan(){if(confirm(T[lang].leaveQ))backHome();}
function makeDraggable(btn,storageKey,onTap){let timer=null,dragging=false,wasDragging=false,startX=0,startY=0,origLeft=0,origTop=0;let saved=JSON.parse(localStorage.getItem(storageKey)||'null');if(saved){btn.classList.add('placed');btn.style.left=saved.left+'px';btn.style.top=saved.top+'px';btn.style.bottom='auto';btn.style.right='auto';}function start(x,y){startX=x;startY=y;wasDragging=false;timer=setTimeout(()=>{dragging=true;wasDragging=true;btn.classList.add('dragging');document.getElementById('dragHint').style.display='block';if(navigator.vibrate)navigator.vibrate(80);let r=btn.getBoundingClientRect();origLeft=r.left;origTop=r.top;btn.style.left=r.left+'px';btn.style.top=r.top+'px';btn.style.bottom='auto';btn.style.right='auto';},1000);}function move(x,y){if(!dragging){clearTimeout(timer);return;}btn.style.left=(origLeft+(x-startX))+'px';btn.style.top=(origTop+(y-startY))+'px';}function end(){clearTimeout(timer);if(dragging){let r=btn.getBoundingClientRect();localStorage.setItem(storageKey,JSON.stringify({left:r.left,top:r.top}));btn.classList.remove('dragging');btn.classList.add('placed');document.getElementById('dragHint').style.display='none';dragging=false;setTimeout(()=>{wasDragging=false;},300);return true;}dragging=false;return false;}btn.addEventListener('touchstart',e=>{start(e.touches[0].clientX,e.touches[0].clientY);},{passive:true});btn.addEventListener('touchmove',e=>{if(dragging){e.preventDefault();move(e.touches[0].clientX,e.touches[0].clientY);}},{passive:false});btn.addEventListener('touchend',e=>{let d=end();if(d){e.preventDefault();e.stopPropagation();}});btn.addEventListener('mousedown',e=>{start(e.clientX,e.clientY);});btn.addEventListener('mousemove',e=>{if(dragging)move(e.clientX,e.clientY);});btn.addEventListener('mouseup',()=>{let d=end();if(d)return;if(!wasDragging&&onTap)onTap();});btn.addEventListener('click',e=>{if(wasDragging){e.preventDefault();e.stopPropagation();}});}
makeDraggable(document.getElementById('adminBtn'),'adminBtnPos',()=>adminLogin());
makeDraggable(document.getElementById('langBtn'),'langBtnPos',()=>openLang());
function togglePoll(){let p=document.getElementById('pollPanel');let open=p.classList.contains('show');if(open){p.classList.remove('show');document.getElementById('pollBtn').classList.remove('open');}else{p.classList.add('show');document.getElementById('pollBtn').classList.add('open');}}
function addPollOpt(){if(document.querySelectorAll('.pollOptVal').length>=6){alert('En fazla 6 şık!');return;}let d=document.createElement('div');d.className='pollOptInput';d.innerHTML=`<input class="pollOptVal" placeholder="Şık ${document.querySelectorAll('.pollOptVal').length+1}"><button onclick="this.parentElement.remove()">✕</button>`;document.getElementById('pollOpts').appendChild(d);}
function createPoll(){let q=document.getElementById('pollQ').value.trim();let opts=[...document.querySelectorAll('.pollOptVal')].map(i=>i.value.trim()).filter(Boolean);if(!q){alert('Soruyu yaz!');return;}if(opts.length<2){alert('En az 2 şık yaz!');return;}let c=clans.find(x=>x.id===currentClanId);c.messages.push({user:isAdmin?'👻 Admin':myName,text:'',poll:{q:q,options:opts,votes:{}},time:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})});save();document.getElementById('pollQ').value='';document.getElementById('pollOpts').innerHTML=`<div class="pollOptInput"><input class="pollOptVal" placeholder="Şık 1 - Örn: Evet"><button onclick="this.parentElement.remove()">✕</button></div><div class="pollOptInput"><input class="pollOptVal" placeholder="Şık 2 - Örn: Hayır"><button onclick="this.parentElement.remove()">✕</button></div>`;togglePoll();renderMessages();}
function votePoll(msgIdx,optIdx){let c=clans.find(x=>x.id===currentClanId);let m=c.messages[msgIdx];if(!m||!m.poll)return;if(m.poll.votes[myName]!==undefined){alert('Zaten oy verdin! ✅');return;}m.poll.votes[myName]=optIdx;save();renderMessages();if(navigator.vibrate)navigator.vibrate(30);}
</script>
</body>
</html>